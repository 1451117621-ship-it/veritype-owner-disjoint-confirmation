# This repository is intentionally a small, publishable evidence package.
# Everything is ignored unless explicitly re-included below.
*
!.gitignore
!README.md
!requirements.txt

!config/
config/*
!config/veritype_cost_constrained_owner_disjoint_confirmation_v2.json

!tools/
tools/*
!tools/build_veritype_confirmatory_results.py

!experiments/
!experiments/exp001_mvp/
!experiments/exp001_mvp/tables/
!experiments/exp001_mvp/tables/veritype_cost_constrained_owner_disjoint_confirmation_v2_observed_bundle/
!experiments/exp001_mvp/tables/veritype_cost_constrained_owner_disjoint_confirmation_v2_observed_bundle/**
!experiments/exp001_mvp/tables/veritype_cost_constrained_owner_disjoint_confirmation_v2_paper_results_v1/
!experiments/exp001_mvp/tables/veritype_cost_constrained_owner_disjoint_confirmation_v2_paper_results_v1/**

# Never publish credentials, LLM response caches, transport captures, or other
# experiment outputs through this evidence repository.
*.env
.env*
*.pem
*.key
.DS_Store
__pycache__/
*.py[cod]
